---
/**
 * Header — pill nav flotante.
 * Estado A (sobre el hero): pill anclada dentro del hero, fondo translúcido.
 * Estado B (scroll fuera del hero): position: fixed, fondo opaco con blur.
 * La transición la maneja src/scripts/animations/header.js (ScrollTrigger).
 */
import { BRAND_DATA } from "../../data/brand";

const { assets, navigation } = BRAND_DATA;
const isExternalHref = (href: string) => /^https?:\/\//i.test(href);
---

<div class="header" data-header>
  <nav class="header__pill" data-header-pill aria-label="Navegación principal">
    <a
      href={navigation.home.href}
      class="header__logo"
      aria-label={navigation.home.label}
      target={isExternalHref(navigation.home.href) ? "_blank" : undefined}
      rel={isExternalHref(navigation.home.href) ? "noopener noreferrer" : undefined}
      set:html={assets.navigationLogoSvg}
    ></a>

    <ul class="header__links" data-header-links>
      {navigation.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="header__link"
            data-header-link
            target={isExternalHref(item.href) ? "_blank" : undefined}
            rel={isExternalHref(item.href) ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="header__toggle"
      data-header-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="header-mobile-menu"
    >
      <span class="header__toggle-bar" aria-hidden="true"></span>
      <span class="header__toggle-bar" aria-hidden="true"></span>
    </button>
  </nav>

  <!-- Menú mobile (drawer simple debajo de la pill) -->
  <div
    class="header__mobile"
    id="header-mobile-menu"
    data-header-mobile
    hidden
  >
    <ul>
      {navigation.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="header__mobile-link"
            data-header-mobile-link
            target={isExternalHref(item.href) ? "_blank" : undefined}
            rel={isExternalHref(item.href) ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .header {
    /* Anclado dentro del hero, encima del contenido */
    position: absolute;
    top: clamp(1rem, 2.4vw, 1.75rem);
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none; /* los hijos reactivan */
    padding: 0 clamp(1rem, 3vw, 2rem);
    /* Oculta por defecto. JS la muestra cuando la intro del hero termina.
       Sin JS, queda oculta — el FAB de WhatsApp y el botón "Comencemos"
       siguen siendo los puntos de entrada funcionales. */
    opacity: 0;
  }

  /* Cuando el hero sale del viewport, la pill se vuelve fixed.
     Mantiene su forma, su blur y su color — solo cambia el contenedor. */
  .header[data-header-state="fixed"] {
    position: fixed;
    top: clamp(0.5rem, 1.4vw, 1rem);
    /* Sigue centrada horizontalmente sobre el viewport */
  }

  .header[data-header-state="fixed"] .header__pill {
    /* Ligeramente más opaca para legibilidad sobre secciones claras */
    background: rgba(26, 26, 26, 0.78);
    border-color: rgba(199, 213, 217, 0.26);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
    transition:
      background 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  .header__pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    padding: 0.45rem 0.45rem 0.45rem clamp(0.85rem, 1.4vw, 1.1rem);
    background: rgba(26, 26, 26, 0.55);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border: 1px solid rgba(199, 213, 217, 0.18);
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    height: 22px;
    color: #ffffff;
    text-decoration: none;
  }

  .header__logo :global(svg) {
    height: 100%;
    width: auto;
    display: block;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 0.6vw, 0.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font: 500 0.85rem/1 var(--font-body);
    letter-spacing: 0.005em;
    border-radius: 999px;
    transition: color 200ms ease, background 200ms ease;
  }

  .header__link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    width: 36px;
    height: 36px;
    margin-left: 0.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(199, 213, 217, 0.25);
    border-radius: 999px;
    cursor: pointer;
    color: #ffffff;
  }

  .header__toggle-bar {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 220ms ease, opacity 220ms ease;
  }

  /* Toggle abierto → X */
  .header[data-mobile-open="true"] .header__toggle-bar:nth-child(1) {
    transform: translateY(2.75px) rotate(45deg);
  }
  .header[data-mobile-open="true"] .header__toggle-bar:nth-child(2) {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* Menú mobile */
  .header__mobile {
    pointer-events: auto;
    margin-top: 0.6rem;
    background: rgba(26, 26, 26, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(199, 213, 217, 0.2);
    border-radius: 18px;
    padding: 0.5rem;
    min-width: 220px;
  }

  .header__mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .header__mobile-link {
    display: block;
    padding: 0.7rem 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font: 500 0.9rem/1 var(--font-body);
    border-radius: 12px;
    transition: background 200ms ease;
  }

  .header__mobile-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  /* Mobile: ocultar links, mostrar toggle */
  @media (max-width: 720px) {
    .header__pill {
      padding: 0.4rem 0.4rem 0.4rem 0.85rem;
      gap: 0.5rem;
      width: 100%;
      justify-content: space-between;
    }

    .header__links {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }

    .header__logo {
      height: 20px;
    }
  }
</style>

<script>
  import { initHeader } from "../../scripts/animations/header.js";
  initHeader();
</script>
