---
import { BRAND_DATA } from "../../data/brand";

const { assets, links, navigation } = BRAND_DATA;
const externalAttributes = {
  target: "_blank",
  rel: "noopener noreferrer",
};
---

<header class="header" data-header data-mobile-open="false">
  <div class="header__bar">
    <div class="header__pill header__navigation">
      <a
        href={navigation.home.href}
        class="header__brand"
        aria-label={navigation.home.label}
        set:html={assets.navigationLogoSvg}
      ></a>

      <span class="header__divider" aria-hidden="true"></span>

      <nav class="header__nav" aria-label="Navegación principal">
        <ul class="header__links" role="list">
          {navigation.items.map((item) => (
            <li><a class="header__link" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <button
        type="button"
        class="header__toggle"
        data-header-toggle
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="header-mobile-menu"
      >
        <span class="header__toggle-bar" aria-hidden="true"></span>
        <span class="header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>

    <a
      class="header__pill header__cta"
      href={links.contact.href}
      {...externalAttributes}
    >
      Agendar cita
    </a>

  </div>

  <nav
    class="header__mobile"
    id="header-mobile-menu"
    data-header-mobile
    aria-label="Navegación mobile"
    hidden
  >
    <ul role="list">
      {navigation.items.map((item) => (
        <li>
          <a href={item.href} class="header__mobile-link" data-header-mobile-link>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: absolute;
    inset: clamp(1rem, 2.4vw, 1.75rem) 0 auto;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    pointer-events: none;
  }

  :global(html.js) .header {
    opacity: 0;
  }

  .header[data-header-state="fixed"] {
    position: fixed;
    top: clamp(0.5rem, 1.4vw, 1rem);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.6rem, 1.2vw, 1rem);
    width: min(100%, 72rem);
  }

  .header__pill {
    pointer-events: auto;
    border: 1px solid color-mix(in srgb, var(--support-neutral) 22%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-black) 68%, transparent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }

  .header[data-header-state="fixed"] .header__navigation,
  .header[data-mobile-open="true"] .header__navigation {
    background: color-mix(in srgb, var(--color-black) 88%, transparent);
    border-color: color-mix(in srgb, var(--support-neutral) 30%, transparent);
  }

  .header__navigation {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.35rem;
  }

  .header__brand {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.55rem;
    height: 2.55rem;
    padding: 0.35rem;
    color: var(--color-white);
    border-radius: 999px;
  }

  .header__brand :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .header__divider {
    width: 1px;
    height: 1.5rem;
    margin-inline: 0.25rem;
    background: color-mix(in srgb, var(--color-white) 20%, transparent);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link,
  .header__mobile-link {
    display: block;
    color: color-mix(in srgb, var(--color-white) 84%, transparent);
    font: 500 0.86rem/1 var(--font-body);
    text-decoration: none;
    border-radius: 999px;
    transition: color 200ms ease, background 200ms ease;
  }

  .header__link {
    padding: 0.7rem clamp(0.75rem, 1.2vw, 1rem);
  }

  .header__link:hover,
  .header__mobile-link:hover {
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-white) 9%, transparent);
  }

  .header__cta {
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(1rem, 1.8vw, 1.4rem);
    color: var(--color-black);
    background: var(--action-primary);
    border-color: var(--action-primary);
    font: 600 0.88rem/1 var(--font-body);
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, transform 200ms ease;
  }

  .header__cta:hover {
    background: var(--action-hover);
    transform: translateY(-2px);
  }

  .header__toggle {
    display: none;
    place-items: center;
    align-content: center;
    gap: 5px;
    width: 2.55rem;
    height: 2.55rem;
    padding: 0;
    color: var(--color-white);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }

  .header__toggle-bar {
    width: 17px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 220ms ease;
  }

  .header[data-mobile-open="true"] .header__toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .header[data-mobile-open="true"] .header__toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .header__mobile {
    pointer-events: auto;
    width: min(100%, 32rem);
    margin-top: 0.6rem;
    padding: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--support-neutral) 24%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-black) 94%, transparent);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header__mobile ul {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__mobile-link {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-inline: 1rem;
  }

  .header__pill:focus-visible,
  .header__brand:focus-visible,
  .header__toggle:focus-visible,
  .header__link:focus-visible,
  .header__mobile-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .header__nav {
      display: none;
    }

    .header__divider {
      display: none;
    }

    .header__navigation {
      gap: 0.1rem;
      padding: 0.25rem;
    }

    .header__cta {
      justify-self: end;
      min-height: 2.85rem;
      padding-inline: clamp(0.85rem, 4vw, 1.15rem);
      font-size: 0.78rem;
    }

    .header__toggle {
      display: grid;
    }
  }

  @media (min-width: 761px) {
    .header__mobile {
      display: none !important;
    }
  }

  @media (max-width: 390px) {
    .header {
      padding-inline: 0.6rem;
    }

    .header__bar {
      gap: 0.4rem;
    }

    .header__cta {
      padding-inline: 0.75rem;
      font-size: 0.73rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__pill,
    .header__link,
    .header__mobile-link,
    .header__toggle-bar {
      transition: none;
    }

    .header__cta:hover {
      transform: none;
    }
  }
</style>

<script>
  import { initHeader } from "../../scripts/animations/header.js";
  initHeader();
</script>
