---
/**
 * Footer compacto en flujo normal.
 * Cierra la página con contexto light después del FinalCTA oscuro.
 * Fondo decorativo: wordmark de Active Club en negro translúcido.
 */
import { BRAND_DATA, type BrandIconName } from "../../data/brand";

const { assets, footer } = BRAND_DATA;
const iconHtml = (name: BrandIconName) => assets.icons[name];
const isExternalHref = (href: string) => /^https?:\/\//i.test(href);

// Año del build: suficiente para un sitio estático que se re-despliega.
const YEAR = new Date().getFullYear();
---

<footer class="footer" data-theme="light">
  <div
    class="footer__wordmark"
    aria-hidden="true"
    set:html={assets.wordmarkSvg}
  />

  <div class="footer__inner">
    <div class="footer__top">
      <p class="footer__claim">{footer.claim}</p>

      <ul class="footer__socials" role="list">
        {
          footer.socials.map((s) => (
            <li>
              <a
                class="footer__social-link"
                href={s.href}
                aria-label={s.label}
                target={isExternalHref(s.href) ? "_blank" : undefined}
                rel={isExternalHref(s.href) ? "noopener noreferrer" : undefined}
                set:html={iconHtml(s.icon)}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © {YEAR} {footer.copyright}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    color: var(--on-surface);
  }

  /* ---------- Wordmark decorativo de fondo ---------- */
  .footer__wordmark {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: clamp(0.25rem, 1vh, 0.75rem);
    transform: translateX(-50%);
    width: min(96%, 90rem);
    color: var(--on-surface);
    opacity: 0.1;
    pointer-events: none;
  }

  .footer__wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Contenido ---------- */
  .footer__inner {
    position: relative;
    z-index: 1; /* por encima del wordmark */
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vh, 2.25rem);
    max-width: 72rem;
    width: 100%;
    margin-inline: auto;
    padding-block: clamp(2rem, 4vh, 3rem) clamp(1rem, 2vh, 1.5rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 3vw, 2rem);
    flex-wrap: wrap;
  }

  .footer__claim {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 24ch;
    margin: 0;
  }

  /* ---------- Redes ---------- */
  .footer__socials {
    display: flex;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--on-surface);
    border: 1px solid var(--border-strong);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .footer__social-link:hover {
    border-color: var(--action-primary);
    background-color: var(--action-primary);
    color: var(--on-action);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .footer__social-link :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
  }

  /* ---------- Copyright ---------- */
  .footer__bottom {
    border-top: 1px solid var(--border-default);
    padding-top: clamp(0.75rem, 1.5vh, 1rem);
  }

  .footer__copy {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.75rem, 0.9vw, 0.85rem);
    color: var(--on-surface-muted);
    margin: 0;
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .footer__social-link {
      transition: none;
    }
  }
</style>
