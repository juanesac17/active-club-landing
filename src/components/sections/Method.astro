---
const STEPS = [
  {
    n: "01",
    title: "Conocemos tu contexto",
    description: "Entendemos tu historia, disponibilidad y objetivos.",
  },
  {
    n: "02",
    title: "Evaluamos y planificamos",
    description: "Definimos prioridades y una ruta realista.",
  },
  {
    n: "03",
    title: "Entrenamos y acompañamos",
    description: "Aplicamos el plan con dirección y confianza.",
  },
  {
    n: "04",
    title: "Medimos y ajustamos",
    description: "El proceso evoluciona según tu respuesta.",
  },
];
---

<section class="method" id="metodo" aria-labelledby="method-title" data-theme="dark">
  <div class="method__inner">
    <header class="method__header">
      <h2 class="method__title" id="method-title">Un método que evoluciona contigo</h2>
      <p class="method__intro">
        Active Club integra entrenamiento personal, preparación física y bienestar
        en un proceso construido desde tu historia, capacidades y objetivos.
      </p>
    </header>

    <ol class="method__grid" role="list">
      {STEPS.map((step, index) => (
        <li class="method__step">
          <span class="method__num" aria-hidden="true">{step.n}</span>
          <h3 class="method__step-title">{step.title}</h3>
          <p class="method__description">{step.description}</p>
          {index < STEPS.length - 1 && (
            <span class="method__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    color: var(--on-surface);
    background: var(--surface);
  }

  .method__inner {
    position: relative;
    z-index: 1;
    max-width: 82rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  .method__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .method__title {
    max-width: 22ch;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .method__intro {
    max-width: 62ch;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: var(--fw-medium);
    line-height: 1.6;
    text-wrap: balance;
  }

  .method__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.8vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .method__step {
    position: relative;
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.4rem, 2.2vw, 2rem);
    border: 2px solid var(--border-default);
    border-radius: 1.25rem;
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .method__step:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .method__num {
    color: var(--highlight);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .method__step-title {
    margin: 0;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    text-wrap: balance;
  }

  .method__description {
    margin: auto 0 0;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    font-weight: var(--fw-light);
    line-height: 1.5;
  }

  .method__arrow {
    position: absolute;
    top: 50%;
    right: clamp(-1.25rem, -1.4vw, -0.75rem);
    z-index: 2;
    width: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--highlight);
    transform: translate(50%, -50%);
  }

  .method__arrow svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .method__grid {
      grid-template-columns: minmax(0, 38rem);
      justify-content: center;
      gap: 3.25rem;
    }

    .method__step {
      min-height: auto;
    }

    .method__description {
      margin-top: 0.5rem;
    }

    .method__arrow {
      top: auto;
      right: 50%;
      bottom: -2.55rem;
      transform: translateX(50%) rotate(90deg);
    }
  }
</style>

<script>
  import { initMethod } from "../../scripts/animations/method.js";
  initMethod();
</script>
