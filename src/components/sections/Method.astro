---
const STEPS = [
  {
    n: "01",
    title: "Conocemos tu contexto",
    description: "Entendemos tu historia, disponibilidad y objetivos.",
  },
  {
    n: "02",
    title: "Evaluamos y planificamos",
    description: "Definimos prioridades y una ruta realista.",
  },
  {
    n: "03",
    title: "Entrenamos y acompañamos",
    description: "Aplicamos el plan con dirección y confianza.",
  },
  {
    n: "04",
    title: "Medimos y ajustamos",
    description: "El proceso evoluciona según tu respuesta.",
  },
];
---

<section class="method" id="metodo" aria-labelledby="method-title" data-theme="dark">
  <div class="method__inner">
    <header class="method__header">
      <h2 class="method__title" id="method-title">Un método que evoluciona contigo</h2>
      <p class="method__intro">
        Active Club integra entrenamiento personal, preparación física y bienestar
        en un proceso construido desde tu historia, capacidades y objetivos.
      </p>
    </header>

    <div class="method__sequence-frame">
      <span class="method__rail" aria-hidden="true">
        <span class="method__rail-progress" data-method-progress></span>
      </span>

      <ol class="method__sequence">
        {STEPS.map((step) => (
          <li class="method__step">
            <span class="method__num" aria-hidden="true">{step.n}</span>
            <div class="method__step-content">
              <h3 class="method__step-title">{step.title}</h3>
              <p class="method__description">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 */
  /* Hallmark · macrostructure: editorial step sequence · genre: editorial · archetype: F4 step sequence */
  .method {
    --method-index-size: clamp(2.25rem, 3vw, 2.75rem);
    --method-index-half: clamp(1.125rem, 1.5vw, 1.375rem);

    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    color: var(--on-surface);
    background: var(--surface);
  }

  .method__inner {
    position: relative;
    z-index: 1;
    max-width: 82rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  .method__header {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
    text-align: left;
  }

  .method__title {
    min-width: 0;
    max-width: 22ch;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .method__intro {
    max-width: 34ch;
    justify-self: end;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: var(--fw-medium);
    line-height: 1.6;
    text-wrap: balance;
  }

  .method__sequence-frame {
    position: relative;
  }

  .method__sequence {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .method__rail {
    position: absolute;
    z-index: 0;
    top: var(--method-index-half);
    right: 12.5%;
    left: 12.5%;
    height: 1px;
    overflow: hidden;
    background: var(--border-default);
  }

  .method__rail-progress {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--highlight);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .method__step {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-rows: var(--method-index-size) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.25rem);
    min-height: clamp(12rem, 18vw, 15rem);
    padding-inline: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .method__num {
    justify-self: center;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: var(--method-index-size);
    padding-inline: 0.5rem;
    background: var(--surface);
    color: var(--highlight);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .method__step-content {
    min-width: 0;
    padding-top: clamp(0.25rem, 1vw, 0.75rem);
    text-align: center;
  }

  .method__step-title {
    margin: 0;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .method__description {
    max-width: 21ch;
    margin: 0.9rem auto 0;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    font-weight: var(--fw-light);
    line-height: 1.5;
  }

  @media (max-width: 63.9375rem) {
    .method__header {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }

    .method__intro {
      justify-self: start;
      max-width: 58ch;
    }

    .method__sequence {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .method__rail {
      top: var(--method-index-half);
      right: auto;
      bottom: var(--method-index-half);
      left: 1.75rem;
      width: 1px;
      height: auto;
    }

    .method__rail-progress {
      width: 100%;
      height: 100%;
      transform: scaleY(0);
      transform-origin: top center;
    }

    .method__step {
      grid-template-columns: minmax(3.5rem, 4.5rem) minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: 1rem;
      min-height: 0;
      padding-inline: 0;
      padding-bottom: 2.75rem;
    }

    .method__step:last-child {
      padding-bottom: 0;
    }

    .method__num {
      justify-self: center;
      grid-column: 1;
      grid-row: 1;
      padding-inline: 0.25rem;
    }

    .method__step-content {
      grid-column: 2;
      grid-row: 1;
      padding-bottom: 0;
    }
  }
</style>

<script>
  import { initMethod } from "../../scripts/animations/method.js";
  initMethod();
</script>
