---
import Button from "../ui/Button.astro";
import { BRAND_DATA } from "../../data/brand";
---

<section class="finalcta" id="contacto" aria-labelledby="finalcta-title" data-theme="dark">
  <div class="finalcta__inner">
    <h2 id="finalcta-title" class="finalcta__title" data-finalcta-title>
      Tu proceso empieza donde estás.
    </h2>
    <div class="finalcta__closing" data-finalcta-closing>
      <p class="finalcta__text">
        Cuéntanos qué quieres lograr. Definiremos la modalidad, frecuencia y
        acompañamiento que mejor encajen contigo, sin compromisos.
      </p>
      <Button href={BRAND_DATA.links.contact.href} variant="outline">
        Agendar mi cita por WhatsApp
      </Button>
    </div>
  </div>
</section>

<style>
  .finalcta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 11vh, 7rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    color: var(--on-surface);
    background: var(--surface);
  }

  .finalcta__inner {
    max-width: 64rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 5vh, 3.5rem);
    text-align: center;
  }

  .finalcta__title {
    max-width: 18ch;
    color: var(--highlight);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .finalcta__closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 4vh, 2.25rem);
  }

  .finalcta__text {
    max-width: 54ch;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: var(--fw-light);
    line-height: 1.6;
    text-wrap: balance;
  }
</style>

<script>
  import { initFinalCta } from "../../scripts/animations/finalcta.js";
  initFinalCta();
</script>
