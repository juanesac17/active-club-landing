---
const FAQS = [
  {
    question: "¿Cuánto cuestan los planes?",
    answer:
      "El valor depende del servicio, modalidad, frecuencia y acompañamiento que necesites. Escríbenos por WhatsApp para conocer tu objetivo y preparar una cotización.",
  },
  {
    question: "¿Necesito experiencia previa?",
    answer:
      "No. El proceso comienza desde tu nivel actual, tanto si estás empezando como si ya entrenas.",
  },
  {
    question: "¿Puedo entrenar con una lesión o antecedente médico?",
    answer:
      "Depende del caso. Cuéntanos cualquier diagnóstico, dolor o antecedente. Algunas situaciones requieren autorización médica. Active Club no reemplaza atención clínica o fisioterapéutica.",
  },
  {
    question: "¿Qué modalidades están disponibles?",
    answer:
      "Trabajamos de forma presencial y virtual. La disponibilidad depende del servicio, ubicación y horarios.",
  },
];

const COLUMNS = [FAQS.slice(0, 2), FAQS.slice(2)];
---

<section class="faq" id="preguntas" aria-labelledby="faq-title" data-theme="light">
  <div class="faq__inner">
    <header class="faq__header">
      <h2 class="faq__title" id="faq-title">Antes de comenzar</h2>
    </header>

    <div class="faq__columns">
      {COLUMNS.map((column, columnIndex) => (
        <div class="faq__list">
          {column.map((item, itemIndex) => {
            const index = columnIndex * 2 + itemIndex;
            return (
              <details class="faq__item" open={index === 0}>
                <summary class="faq__question">
                  <span>{item.question}</span>
                  <span class="faq__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>
                <div class="faq__answer"><p>{item.answer}</p></div>
              </details>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    color: var(--on-surface);
    background: var(--surface);
  }

  .faq__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  .faq__header {
    text-align: center;
  }

  .faq__title {
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .faq__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: start;
  }

  .faq__list {
    display: grid;
    gap: clamp(0.75rem, 1.5vh, 1.1rem);
  }

  .faq__item {
    overflow: clip;
    border: 2px solid var(--border-default);
    border-radius: 1.25rem;
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .faq__item[open] {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-featured);
  }

  .faq__item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .faq__item[open]:hover {
    box-shadow: var(--shadow-card-featured);
  }

  .faq__question {
    min-height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.25rem, 2.2vw, 1.75rem);
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    text-wrap: balance;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -4px;
    border-radius: 1.15rem;
  }

  .faq__icon {
    flex: 0 0 auto;
    width: clamp(2.25rem, 3vw, 2.75rem);
    height: clamp(2.25rem, 3vw, 2.75rem);
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--on-surface);
    background: color-mix(in srgb, var(--on-surface) 8%, transparent);
    transition: color 0.3s ease, background 0.3s ease, transform 0.35s ease;
  }

  .faq__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .faq__item[open] .faq__icon {
    color: var(--on-positive);
    background: var(--positive-surface);
    transform: rotate(180deg);
  }

  .faq__answer {
    padding: 0 clamp(1.25rem, 2.2vw, 1.75rem) clamp(1.1rem, 2vw, 1.5rem);
  }

  .faq__answer p {
    margin: 0;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    font-weight: var(--fw-medium);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .faq__columns {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item,
    .faq__icon {
      transition: none;
    }
  }
</style>
