---
/**
 * Sección 5 — El Entrenador.
 * Presenta a la persona detrás de Active Club: perfil profesional + historia
 * de origen, con foto y accesos directos a redes sociales.
 *
 * Capa 2 (trainer.js): entrada por scroll (ScrollTrigger, one-time) — columna
 * de texto con stagger + foto con slide-in independiente.
 */
import trainerPhoto from "../../assets/images/trainer-placeholder.svg";

// Íconos de marca (currentColor) cargados de una sola vez.
const icons = import.meta.glob("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const iconHtml = (name: string) => icons[`../../assets/icons/${name}.svg`];

// TODO: reemplazar por el link wa.me real cuando esté el número (whatsapp.js).
const WHATSAPP_URL = "#contacto";

const SOCIALS = [
  // TODO: reemplazar por URL real de Instagram.
  { icon: "instagram", label: "Instagram", href: "#" },
  { icon: "whatsapp", label: "WhatsApp", href: WHATSAPP_URL },
  // TODO: reemplazar por URL real de TikTok.
  { icon: "tiktok", label: "TikTok", href: "#" },
];
---

<section class="trainer" id="entrenador" aria-labelledby="trainer-title">
  <div class="trainer__inner">
    <div class="trainer__content">
      <p class="trainer__eyebrow">El Entrenador</p>
      <h2 class="trainer__title" id="trainer-title">Me llamo Juan Esteban</h2>
      <div class="trainer__body">
        <p>
          Soy entrenador certificado con más de 10 años de experiencia. Creo que
          entrenar no debería sentirse como un castigo, sino como una parte más
          del cuidado de tu bienestar.
        </p>
        <p>
          Creé Active Club después de ver a demasiadas personas abandonar
          gimnasios donde las trataban como un número más. Acá cada plan se
          construye alrededor de una persona, no al revés.
        </p>
      </div>
      <ul class="trainer__socials" role="list">
        {SOCIALS.map((s) => (
          <li>
            <a
              class="trainer__social-link"
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              set:html={iconHtml(s.icon)}
            />
          </li>
        ))}
      </ul>
    </div>
    <figure class="trainer__photo">
      <span class="trainer__photo-glow" aria-hidden="true"></span>
      <img
        class="trainer__photo-img"
        src={trainerPhoto.src}
        width={trainerPhoto.width}
        height={trainerPhoto.height}
        alt="Juan Esteban, entrenador de Active Club"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .trainer {
    position: relative;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .trainer__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    padding-block: clamp(5rem, 14vh, 9rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  /* ---------- Columna de texto ---------- */
  .trainer__eyebrow {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: var(--fw-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .trainer__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .trainer__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-block: 1.5rem 2rem;
    max-width: 52ch;
  }

  .trainer__body p {
    font-family: var(--font-body);
    font-weight: var(--fw-light);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-white) 72%, transparent);
  }

  /* ---------- Redes sociales ---------- */
  .trainer__socials {
    display: flex;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .trainer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--color-text-on-dark);
    border: 1px solid color-mix(in srgb, var(--color-white) 35%, transparent);
    transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  .trainer__social-link:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-black);
  }

  .trainer__social-link:focus-visible {
    outline: 2px solid var(--color-cta-hover);
    outline-offset: 3px;
  }

  .trainer__social-link :global(svg) {
    width: 20px;
    height: 20px;
    display: block;
  }

  /* ---------- Foto ---------- */
  .trainer__photo {
    position: relative;
    isolation: isolate;
    aspect-ratio: 9 / 16;
    width: 100%;
    max-width: clamp(16rem, 24vw, 24rem);
    margin-inline: auto;
    border-radius: 1.25rem;
    border: 4px solid var(--color-accent);
    overflow: hidden;
    transition: box-shadow 0.4s ease;
  }

  .trainer__photo:hover {
    box-shadow: 0 0 2.75rem color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  /* Iluminación interna: el borde marca el halo exterior (box-shadow); esta
     capa ilumina el interior del recorte desde los bordes hacia adentro. */
  .trainer__photo-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
    background: radial-gradient(
      120% 120% at 50% 50%,
      transparent 55%,
      color-mix(in srgb, var(--color-accent) 45%, transparent) 100%
    );
  }

  .trainer__photo:hover .trainer__photo-glow {
    opacity: 1;
  }

  .trainer__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Responsive: apilar en mobile ---------- */
  @media (max-width: 768px) {
    .trainer__inner {
      grid-template-columns: 1fr;
    }
    .trainer__photo {
      order: -1;
      max-width: 18rem;
    }
  }

  /* ---------- Reduced motion: sin transiciones, hover se mantiene ---------- */
  @media (prefers-reduced-motion: reduce) {
    .trainer__social-link,
    .trainer__photo,
    .trainer__photo-glow {
      transition: none;
    }
  }
</style>

<script>
  import { initTrainer } from "../../scripts/animations/trainer.js";
  initTrainer();
</script>
