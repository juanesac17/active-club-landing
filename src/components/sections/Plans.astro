---
/**
 * Sección 7 — Planes.
 * Tabla comparativa editorial: tres niveles de acompañamiento sin cards,
 * con precios en COP y separadores horizontales. Active destacado por
 * hairline accent, no por badge.
 *
 * Sin animaciones — el contenido es visible desde el primer render.
 */
const PLANS = [
  {
    name: "Starter",
    focus: "Para comenzar con una ruta clara.",
    price: "$180.000",
    features: [
      "Entrenamiento virtual",
      "Plan personalizado",
      "Seguimiento mensual",
    ],
    featured: false,
  },
  {
    name: "Active",
    focus: "Para combinar autonomía y acompañamiento presencial.",
    price: "$320.000",
    features: [
      "Cuatro sesiones presenciales al mes",
      "Ajustes quincenales",
      "Soporte por WhatsApp",
    ],
    featured: true,
  },
  {
    name: "Elite",
    focus: "Para un acompañamiento más frecuente e individualizado.",
    price: "$480.000",
    features: [
      "Sesiones presenciales ilimitadas",
      "Acompañamiento dedicado",
      "Evaluación física mensual",
    ],
    featured: false,
  },
];
---

<section class="plans" id="planes" aria-labelledby="plans-title" data-theme="light">
  <div class="plans__inner">
    <header class="plans__header">
      <h2 class="plans__title" id="plans-title">Elige cómo quieres comenzar</h2>
    </header>

    <div class="plans__table" role="table" aria-label="Comparación de planes">
      {
        PLANS.map((plan) => (
          <article
            class="plans__row"
            data-featured={plan.featured ? "true" : undefined}
            role="row"
          >
            <div class="plans__cell plans__cell--name" role="cell">
              <h3 class="plans__name">{plan.name}</h3>
            </div>

            <div class="plans__cell plans__cell--price" role="cell">
              <span class="plans__price">{plan.price}</span>
            </div>

            <div class="plans__cell plans__cell--focus" role="cell">
              <p class="plans__focus">{plan.focus}</p>
            </div>

            <div class="plans__cell plans__cell--features" role="cell">
              <ul class="plans__features" role="list">
                {plan.features.map((feature) => (
                  <li class="plans__feature">
                    <svg
                      class="plans__check"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path
                        d="M5 13l4 4L19 7"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 */
  /* Hallmark · macrostructure: stat-led comparison · genre: editorial */
  .plans {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .plans__inner {
    max-width: 78rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  /* ---------- Encabezado asimétrico ---------- */
  .plans__header {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
    text-align: left;
  }

  .plans__title {
    min-width: 0;
    max-width: 22ch;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  /* ---------- Tabla comparativa ---------- */
  .plans__table {
    display: flex;
    flex-direction: column;
  }

  .plans__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(7rem, 0.8fr) minmax(12rem, 1.2fr) minmax(14rem, 1.5fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vh, 2.25rem);
    border-bottom: 1px solid var(--border-default);
  }

  .plans__row:first-child {
    border-top: 1px solid var(--border-default);
  }

  .plans__row[data-featured] {
    border-left: 3px solid var(--highlight);
    padding-left: clamp(1rem, 2vw, 1.5rem);
  }

  .plans__cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .plans__cell--name {
    padding-top: 0.25rem;
  }

  .plans__cell--price {
    padding-top: 0.25rem;
  }

  .plans__name {
    margin: 0;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .plans__price {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    color: var(--on-surface);
    line-height: 1.2;
  }

  .plans__focus {
    margin: 0;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.45vw, 1.1rem);
    font-weight: var(--fw-medium);
    line-height: 1.45;
  }

  .plans__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1vh, 0.75rem);
  }

  .plans__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.5;
    color: var(--on-surface-muted);
  }

  .plans__check {
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.2em;
    color: var(--positive);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 63.9375rem) {
    .plans__header {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }

    .plans__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding-block: clamp(2rem, 4vh, 2.75rem);
    }

    .plans__row[data-featured] {
      border-left: 3px solid var(--highlight);
      padding-left: 1rem;
    }

    .plans__cell--name {
      padding-top: 0;
    }

    .plans__cell--price {
      padding-top: 0;
    }
  }
</style>
