---
/**
 * Sección 7 — Planes.
 * 3 planes (Starter, Active, Elite) en cards simples con el mismo
 * lenguaje visual que Method.astro. El plan Active va destacado con
 * borde estructural reforzado y badge "Más popular".
 *
 * Capa 2 (plans.js): spotlight neutral que sigue al cursor dentro de
 * cada card (CSS vars --spot-x/--spot-y + radial-gradient en ::after).
 */
import Button from "../ui/Button.astro";
import { BRAND_DATA } from "../../data/brand";

const PLANS = [
  {
    name: "Starter",
    focus: "Para comenzar con una ruta clara.",
    features: [
      "Entrenamiento virtual",
      "Plan personalizado",
      "Seguimiento mensual",
    ],
    featured: false,
  },
  {
    name: "Active",
    focus: "Para combinar autonomía y acompañamiento presencial.",
    features: [
      "Cuatro sesiones presenciales al mes",
      "Ajustes quincenales",
      "Soporte por WhatsApp",
    ],
    featured: true,
  },
  {
    name: "Elite",
    focus: "Para un acompañamiento más frecuente e individualizado.",
    features: [
      "Sesiones presenciales ilimitadas",
      "Acompañamiento dedicado",
      "Evaluación física mensual",
    ],
    featured: false,
  },
];
---

<section class="plans" id="planes" aria-labelledby="plans-title" data-theme="light">
  <div class="plans__inner">
    <header class="plans__header">
      <h2 class="plans__title" id="plans-title">Elige cómo quieres comenzar</h2>
      <p class="plans__intro">
        Tres niveles de acompañamiento, ajustables según tu objetivo y disponibilidad.
      </p>
    </header>

    <ul class="plans__grid" role="list">
      {
        PLANS.map((plan) => (
          <li
            class="plans__card"
            data-featured={plan.featured ? "true" : undefined}
          >
            {plan.featured && <span class="plans__badge">Más popular</span>}
            <h3 class="plans__name">{plan.name}</h3>
            <p class="plans__focus">{plan.focus}</p>
            <ul class="plans__features" role="list">
              {plan.features.map((feature) => (
                <li class="plans__feature">
                  <svg
                    class="plans__check"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 13l4 4L19 7"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="plans__conversion">
      <p class="plans__quote-note">
        El valor depende del servicio, modalidad, frecuencia y nivel de acompañamiento.
        Conversemos para recomendarte una opción y preparar tu cotización.
      </p>
      <Button href={BRAND_DATA.links.contact.href} variant="primary">
        Consultar y agendar por WhatsApp
      </Button>
    </div>
  </div>
</section>

<style>
  .plans {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .plans__inner {
    max-width: 78rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  /* ---------- Encabezado ---------- */
  .plans__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .plans__intro {
    max-width: 54ch;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    text-wrap: balance;
  }

  .plans__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 26ch;
    color: var(--on-surface);
  }

  /* ---------- Grid de planes ---------- */
  .plans__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: stretch;
  }

  /* ---------- Card (mismo lenguaje visual que .method__step) ---------- */
  .plans__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border-radius: 1.25rem;
    border: 2px solid var(--border-default);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    overflow: hidden; /* recorta el spotlight al radio de la card */
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .plans__card[data-featured] {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-featured);
  }

  /* Spotlight neutral que sigue al cursor (plans.js actualiza las vars). */
  .plans__card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      14rem circle at var(--spot-x, 50%) var(--spot-y, 50%),
      color-mix(in srgb, var(--on-surface) 7%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .plans__card:hover::after {
    opacity: 1;
  }

  .plans__card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .plans__card[data-featured]:hover {
    box-shadow: var(--shadow-card-featured);
  }

  /* ---------- Badge "Más popular" ---------- */
  .plans__badge {
    align-self: flex-start;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.7rem, 0.85vw, 0.8rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-highlight);
    background: var(--highlight-surface);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    margin-bottom: 0.35rem;
  }

  /* ---------- Contenido ---------- */
  .plans__name {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--on-surface);
    margin: 0;
  }

  .plans__focus {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(1rem, 1.45vw, 1.15rem);
    line-height: 1.45;
    color: var(--on-surface-muted);
    margin: 0 0 0.75rem;
  }

  .plans__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.65rem, 1.2vh, 0.9rem);
  }

  .plans__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.5;
    color: var(--on-surface-muted);
  }

  .plans__check {
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.2em;
    color: var(--positive);
  }

  .plans__features {
    margin-bottom: clamp(1.25rem, 2.5vh, 2rem);
  }

  .plans__conversion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .plans__quote-note {
    max-width: 62ch;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    font-weight: var(--fw-medium);
    line-height: 1.6;
    text-wrap: balance;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .plans__grid {
      grid-template-columns: 1fr;
      max-width: 28rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>

<script>
  import { initPlans } from "../../scripts/animations/plans.js";
  initPlans();
</script>
