---
/**
 * Sección 7 — Planes.
 * Cuatro tarjetas con resumen frontal y detalle al reverso. El giro se
 * adapta a mouse, touch, teclado y preferencias de movimiento reducido.
 */
import logoHorizontalUrl from "../../assets/images/logo-horizontal.svg?url";
import { PLANS } from "../../data/plans";
import Button from "../ui/Button.astro";
---

<section
  class="plans"
  id="planes"
  aria-labelledby="plans-title"
  data-theme="light"
  data-plans
>
  <div class="plans__inner">
    <header class="plans__header">
      <h2 class="plans__title" id="plans-title">Elige cómo quieres comenzar</h2>
    </header>

    <div class="plans__grid">
      {
        PLANS.map((plan) => (
          <article
            class="plan-card"
            data-plan-card
            data-featured={plan.featured ? "true" : undefined}
            data-flipped="false"
          >
            <div class="plan-card__scene">
              <div class="plan-card__inner">
                <div
                  class="plan-card__face plan-card__face--front"
                  data-card-front
                  aria-hidden="false"
                >
                  <div class="plan-card__eyebrow plan-card__eyebrow--front">
                    {plan.featured && (
                      <span class="plan-card__badge">Recomendado</span>
                    )}
                  </div>

                  <h3
                    class="plan-card__name"
                    id={`plan-${plan.id}-front-title`}
                  >
                    {plan.name}
                  </h3>

                  <p class="plan-card__price">{plan.price}</p>
                  <p class="plan-card__focus">{plan.focus}</p>

                  <ul class="plan-card__features" role="list">
                    {plan.features.map((feature) => (
                      <li class="plan-card__feature">
                        <svg
                          class="plan-card__check"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            d="M5 13l4 4L19 7"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="plan-card__front-action">
                    <button
                      class="plan-card__toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`plan-${plan.id}-details`}
                      data-card-open
                    >
                      Mostrar más detalles
                    </button>
                  </div>
                </div>

                <div
                  class="plan-card__face plan-card__face--back"
                  id={`plan-${plan.id}-details`}
                  data-card-back
                  aria-hidden="true"
                  role="group"
                  aria-labelledby={`plan-${plan.id}-back-title`}
                  inert
                >
                  <div class="plan-card__eyebrow">
                    <span class="plan-card__side">Detalles</span>
                    {plan.featured && (
                      <span class="plan-card__badge">Recomendado</span>
                    )}
                  </div>

                  <h3
                    class="visually-hidden"
                    id={`plan-${plan.id}-back-title`}
                  >
                    Detalles del plan {plan.name}
                  </h3>

                  <img
                    class="plan-card__logo"
                    src={logoHorizontalUrl}
                    alt=""
                    width="5149"
                    height="1487"
                    decoding="async"
                    aria-hidden="true"
                  />

                  <div class="plan-card__description">
                    {plan.description.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>

                  <div class="plan-card__recommended">
                    <h4>Recomendado para</h4>
                    <ul role="list">
                      {plan.description.recommendedFor.map((item) => (
                        <li>
                          <span aria-hidden="true" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="plan-card__back-actions">
                    <div class="plan-card__cta">
                      <Button href={plan.cta.href} variant="primary">
                        {plan.cta.label}
                      </Button>
                    </div>
                    <button
                      class="plan-card__toggle plan-card__toggle--return"
                      type="button"
                      data-card-close
                    >
                      Volver al resumen
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 */
  /* Hallmark · macrostructure: paired flip grid · genre: editorial */
  .plans {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-block: clamp(4rem, 10vh, 6rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .plans__inner {
    max-width: 78rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 5rem);
  }

  .plans__header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    text-align: left;
  }

  .plans__title {
    min-width: 0;
    max-width: 22ch;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .plans__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .plan-card {
    min-width: 0;
    display: flex;
    perspective: 80rem;
  }

  .plan-card__scene,
  .plan-card__inner {
    width: 100%;
    min-height: 100%;
  }

  .plan-card__scene {
    display: grid;
  }

  .plan-card__inner {
    display: grid;
    transform-style: preserve-3d;
    transition: transform 0.36s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .plan-card[data-flipped="true"] .plan-card__inner {
    transform: rotateY(180deg);
  }

  .plan-card__face {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 4px solid var(--border-default);
    border-radius: clamp(1.4rem, 3vw, 2rem);
    color: var(--on-surface);
    background: var(--surface-raised);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .plan-card__face--back {
    transform: rotateY(180deg);
  }

  .plan-card[data-featured] .plan-card__face {
    border: 3px solid var(--positive);
    background: linear-gradient(
      145deg,
      var(--surface-raised) 0%,
      color-mix(
          in srgb,
          var(--surface-raised) 91%,
          var(--positive-surface) 9%
        )
        100%
    );
  }

  .plan-card__eyebrow {
    min-height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .plan-card__eyebrow--front {
    justify-content: flex-end;
  }

  .plan-card__side,
  .plan-card__badge {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .plan-card__side {
    color: var(--on-surface-muted);
  }

  .plan-card__badge {
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    color: var(--on-positive);
    background: var(--positive-surface);
  }

  .plan-card__name {
    max-width: 15ch;
    margin: 0;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    font-weight: var(--fw-bold);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .plan-card__logo {
    display: block;
    width: min(12rem, 48%);
    height: auto;
    margin-inline: auto;
  }

  .plan-card__price {
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    color: var(--on-surface);
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    text-wrap: balance;
    text-align: center;
  }

  .plan-card__focus {
    max-width: 38ch;
    margin: 0.9rem 0 0;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    text-wrap: pretty;
    text-align: center;
  }

  .plan-card__features {
    list-style: none;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plan-card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    font-weight: var(--fw-medium);
    line-height: 1.45;
  }

  .plan-card__check {
    flex: 0 0 auto;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.17em;
    color: var(--positive);
  }

  .plan-card__front-action {
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .plan-card__toggle {
    width: 100%;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--on-surface);
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .plan-card__toggle:hover {
    color: var(--surface);
    background: var(--on-surface);
    border-color: var(--on-surface);
  }

  .plan-card__toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  /* ---------- Reverso ---------- */
  .plan-card__description {
    max-width: 48ch;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    font-weight: var(--fw-medium);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .plan-card__description p {
    margin: 0 0 1rem;
  }

  .plan-card__description p:last-child {
    margin-bottom: 0;
  }

  .plan-card__recommended {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .plan-card__recommended h4 {
    margin: 0 0 0.9rem;
    color: var(--on-surface);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: var(--fw-bold);
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .plan-card__recommended ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .plan-card__recommended li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--on-surface-muted);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.35vw, 1rem);
    font-weight: var(--fw-medium);
    line-height: 1.45;
  }

  .plan-card__recommended li > span {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--positive);
  }

  .plan-card__back-actions {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .plan-card__cta :global(.btn) {
    width: 100%;
  }

  /* ---------- Responsive ---------- */
  @media (min-width: 48.0625rem) and (hover: hover) and (pointer: fine) {
    .plan-card__toggle {
      position: absolute;
      width: 1px;
      min-width: 1px;
      height: 1px;
      min-height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .plan-card__toggle:focus-visible {
      position: relative;
      width: 100%;
      min-width: 0;
      height: auto;
      min-height: 44px;
      padding: 0.75rem 1rem;
      margin: 0;
      overflow: visible;
      clip: auto;
      clip-path: none;
      white-space: normal;
      border: 1px solid var(--border-strong);
    }

  }

  @media (max-width: 48rem) {
    .plans__header {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }

    .plans__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-card__inner,
    .plan-card__toggle {
      transition: none;
    }

    .plan-card__inner,
    .plan-card[data-flipped="true"] .plan-card__inner,
    .plan-card__face--back {
      transform: none;
    }

    .plan-card__face[aria-hidden="true"] {
      visibility: hidden;
      opacity: 0;
    }

    .plan-card__face[aria-hidden="false"] {
      visibility: visible;
      opacity: 1;
    }
  }
</style>

<script>
  const HOVER_MEDIA_QUERY =
    "(min-width: 48.0625rem) and (hover: hover) and (pointer: fine)";
  const hoverMedia = window.matchMedia(HOVER_MEDIA_QUERY);
  const planSections = document.querySelectorAll<HTMLElement>("[data-plans]");

  planSections.forEach((plans) => {
    if (plans.dataset.flipInitialized === "true") return;

    plans.dataset.flipInitialized = "true";
    const cards = plans.querySelectorAll<HTMLElement>("[data-plan-card]");

    cards.forEach((card) => {
      const front = card.querySelector<HTMLElement>("[data-card-front]");
      const back = card.querySelector<HTMLElement>("[data-card-back]");
      const openButton = card.querySelector<HTMLButtonElement>("[data-card-open]");
      const closeButton = card.querySelector<HTMLButtonElement>("[data-card-close]");
      const cta = back?.querySelector<HTMLAnchorElement>(".plan-card__cta a");

      if (!front || !back || !openButton || !closeButton) return;

      let pointerInside = false;

      const setFaceHidden = (face: HTMLElement, hidden: boolean) => {
        face.inert = hidden;
        face.setAttribute("aria-hidden", String(hidden));
      };

      const focusElement = (element: HTMLElement) => {
        requestAnimationFrame(() => element.focus({ preventScroll: true }));
      };

      const setFlipped = (flipped: boolean, focusTarget?: HTMLElement) => {
        card.dataset.flipped = String(flipped);
        openButton.setAttribute("aria-expanded", String(flipped));
        setFaceHidden(front, flipped);
        setFaceHidden(back, !flipped);

        if (focusTarget) focusElement(focusTarget);
      };

      setFlipped(false);

      card.addEventListener("pointerenter", () => {
        if (!hoverMedia.matches) return;

        pointerInside = true;
        setFlipped(true);
      });

      card.addEventListener("pointerleave", () => {
        if (!hoverMedia.matches) return;

        pointerInside = false;
        if (!back.contains(document.activeElement)) setFlipped(false);
      });

      openButton.addEventListener("click", () => {
        setFlipped(true, cta ?? closeButton);
      });

      closeButton.addEventListener("click", () => {
        setFlipped(false, openButton);
      });

      card.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || card.dataset.flipped !== "true") return;

        event.preventDefault();
        setFlipped(false, openButton);
      });

      card.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (!pointerInside && !card.contains(document.activeElement)) {
            setFlipped(false);
          }
        });
      });

      hoverMedia.addEventListener("change", () => {
        pointerInside = false;
        if (!card.contains(document.activeElement)) setFlipped(false);
      });
    });
  });
</script>
