---
/**
 * Sección 4 — ¿Para quién es Active Club?
 * Cuatro contextos de entrada en una matriz editorial 2×2.
 *
 * En desktop, ScrollTrigger reproduce el reveal al entrar en el viewport.
 * En mobile el contenido se apila sin animación.
 */

import Button from "../ui/Button.astro";
import { BRAND_DATA } from "../../data/brand";

// Íconos de marca (currentColor) cargados de una sola vez. Agregar un perfil =
// sumar un objeto a PROFILES; su `icon` debe existir en src/assets/icons/.
const icons = import.meta.glob("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const iconHtml = (name: string) => icons[`../../assets/icons/${name}.svg`];

const PROFILES = [
  {
    icon: "dumbbell",
    title: "Estás comenzando o retomando",
    text: "Quieres construir constancia y entrenar con dirección.",
  },
  {
    icon: "kettlebell",
    title: "Quieres mejorar tu bienestar",
    text: "Buscas más fuerza, movilidad y energía para tu día a día.",
  },
  {
    icon: "stopwatch",
    title: "Practicas running u otro deporte",
    text: "Necesitas preparar tu cuerpo para las demandas de tu disciplina.",
  },
  {
    icon: "hand-grip",
    title: "Necesitas mayor individualización",
    text: "Tu historia, objetivos o limitaciones requieren atención específica.",
  },
];

---

<section
  class="forwho"
  id="para-quien"
  aria-labelledby="forwho-title"
  data-theme="light"
  data-forwho-section
>
  <div class="forwho__inner">
    <header class="forwho__header">
      <h2 class="forwho__title" id="forwho-title">Tu punto de partida también cuenta</h2>
    </header>
  </div>

  <div class="forwho__matrix" data-forwho-matrix>
    <span class="forwho__divider forwho__divider--horizontal" aria-hidden="true" />
    <span class="forwho__divider forwho__divider--vertical" aria-hidden="true" />
    <ul class="forwho__grid" role="list">
      {
        PROFILES.map((profile) => (
          <li class="forwho__item" data-forwho-item>
            <span class="forwho__icon" set:html={iconHtml(profile.icon)} aria-hidden="true" />
            <h3 class="forwho__profile">{profile.title}</h3>
            <p class="forwho__profile-desc">{profile.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="forwho__cta" data-forwho-cta>
    <p class="forwho__desc">
      Acompañamos distintos objetivos, niveles de experiencia y formas de entrenar.
    </p>
    <Button href={BRAND_DATA.links.contact.href} variant="primary">
      Quiero comenzar
    </Button>
  </div>
</section>

<style>
  .forwho {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    background: var(--surface);
    color: var(--on-surface);
    padding-block: clamp(6rem, 12svh, 8rem) clamp(2.5rem, 5svh, 4rem);
    overflow: clip;
  }

  .forwho__inner {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  /* ---------- Encabezado ---------- */
  .forwho__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .forwho__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--on-surface);
  }

  .forwho__desc {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
    text-wrap: balance;
    max-width: 40ch;
    color: var(--on-surface-muted);
  }

  /* ---------- Matriz editorial ---------- */
  .forwho__matrix {
    position: relative;
    width: min(100% - 2.5rem, 72rem);
    margin: clamp(2rem, 5svh, 3.5rem) auto 0;
  }

  .forwho__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: clamp(22rem, 52svh, 32rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .forwho__divider {
    position: absolute;
    z-index: 2;
    display: block;
    background: var(--border-strong);
    pointer-events: none;
  }

  .forwho__divider--horizontal {
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    transform-origin: center;
  }

  .forwho__divider--vertical {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform-origin: center;
  }

  .forwho__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: clamp(2rem, 4vw, 4rem);
    text-align: center;
  }

  .forwho__icon {
    display: block;
    width: clamp(2.75rem, 4vw, 3.5rem);
    color: var(--positive);
  }

  .forwho__icon :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .forwho__profile {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 24ch;
    color: var(--on-surface);
    margin: 0;
  }

  .forwho__profile-desc {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.5;
    max-width: 34ch;
    color: var(--on-surface-muted);
    margin: 0;
  }

  .forwho__cta {
    width: min(100% - 2.5rem, 72rem);
    margin: clamp(2rem, 5svh, 3rem) auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .forwho {
      display: block;
      min-height: auto;
      padding-block: clamp(5.5rem, 14svh, 7rem) clamp(3rem, 8svh, 5rem);
    }

    .forwho__header {
      gap: 0.5rem;
    }

    .forwho__title {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }

    .forwho__desc {
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .forwho__matrix {
      width: min(100% - 2.5rem, 36rem);
      margin-top: 2rem;
    }

    .forwho__grid {
      display: block;
      min-height: 0;
    }

    .forwho__divider {
      display: none;
    }

    .forwho__item {
      gap: 0.75rem;
      padding: 2rem 0;
    }

    .forwho__item + .forwho__item {
      border-top: 1px solid var(--border-strong);
    }

    .forwho__icon {
      width: 2.25rem;
    }

    .forwho__profile {
      font-size: 1.1rem;
    }

    .forwho__profile-desc {
      font-size: 0.875rem;
      line-height: 1.4;
    }
  }

</style>

<script>
  import { initForWho } from "../../scripts/animations/forwho.js";
  initForWho();
</script>
