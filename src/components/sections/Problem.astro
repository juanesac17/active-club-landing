---
/**
 * Sección 3 — El problema que ayudamos a resolver.
 * Título, un párrafo y tres mensajes destacados.
 *
 * Animaciones (problem.js):
 *  - Párrafos: reveal por LÍNEAS con giro 3D (clonado de FinalCTA).
 *  - Mensajes destacados: sin entrada con scroll; énfasis tipográfico.
 */
import problemLogoUrl from "../../assets/images/logotipo-negro.svg?url";

const PARAGRAPHS = [
  "Entrenar más no siempre significa avanzar. Sin un proceso que considere tu punto de partida, tu tiempo y la respuesta de tu cuerpo, es fácil perder constancia y confianza.",
];

const HIGHLIGHTS = [
  "No necesitas encajar en un plan genérico.",
  "Necesitas entender qué hacer y cómo avanzar.",
  "El entrenamiento debe evolucionar contigo.",
];
---

<section class="problem" id="problema" data-theme="light">
  <img
    class="problem__logo"
    src={problemLogoUrl}
    alt=""
    width="2914"
    height="2528"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />

  <div class="problem__inner">
    <h2 class="problem__title">Tu esfuerzo necesita dirección, no otra rutina.</h2>

    <div class="problem__paragraphs">
      {PARAGRAPHS.map((text) => (
        <p class="problem__paragraph">{text}</p>
      ))}
    </div>

    <ul class="problem__highlights" role="list">
      {HIGHLIGHTS.map((text) => (
        <li class="problem__highlight">{text}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problem {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-top: clamp(4rem, 10vh, 6rem);
    padding-bottom: clamp(3.5rem, 9vh, 5.5rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .problem__inner {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  .problem__logo {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: clamp(24rem, 48vw, 44rem);
    height: auto;
    opacity: 0.08;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  /* ---------- Título (mismo tamaño que About) ---------- */
  .problem__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 22ch;
    color: var(--on-surface);
  }

  /* ---------- Párrafos ---------- */
  .problem__paragraphs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: clamp(2rem, 6vh, 3rem);
    width: 100%;
    max-width: 58rem;
  }

  .problem__paragraph {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.5;
    text-wrap: balance;
    color: var(--on-surface-muted);
  }

  /* ---------- Mensajes destacados (lista simple) ---------- */
  .problem__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.85rem, 2vh, 1.25rem);
    width: 100%;
    max-width: 44rem;
  }

  .problem__highlight {
    font-family: var(--font-body);
    font-weight: var(--fw-bold);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    text-align: left;
    text-wrap: balance;
    color: var(--on-surface);
    position: relative;
    padding-left: 1.5rem;
  }

  .problem__highlight::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--highlight);
    font-size: 1.1em;
    line-height: inherit;
  }

  @media (max-width: 768px) {
    .problem__logo {
      width: 88%;
      opacity: 0.06;
    }
  }
</style>

<script>
  import { initProblem } from "../../scripts/animations/problem.js";
  initProblem();
</script>
