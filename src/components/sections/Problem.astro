---
/**
 * Sección 2 — Problema / Promesa (el "valle emocional").
 * Frases centradas y grandes, una a la vez; frase puente (giro) en naranja.
 * Capa 2 (problem.js): reveal por caracteres con SplitText + ScrollTrigger (one-time).
 */

// Pain points en segunda persona. Cada uno entra al scrollear, una frase a la vez.
const PAINS = [
  "¿Llevas meses en el gym y no ves resultados?",
  "¿No sabes si estás entrenando bien o solo te estás cansando?",
  "¿Empiezas con motivación y al poco tiempo lo abandonas?",
];
---

<section class="problem" id="problema">
  <div class="problem__inner">
    <div class="problem__pains">
      {PAINS.map((pain) => <p class="problem__pain">{pain}</p>)}
    </div>

    <p class="problem__bridge">
      Eso cambia cuando entrenas con un método, no con suposiciones.
    </p>

    <div class="problem__footer">
      <p class="problem__footer-text">¿Por qué Active Club es diferente?</p>
      <span class="problem__footer-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M12 4v13M7 13l5 5 5-5"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</section>

<style>
  .problem {
    position: relative;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding-block: clamp(7rem, 22vh, 14rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .problem__inner {
    max-width: 64rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* Espacio entre la cascada de frases y el giro. */
    gap: clamp(6rem, 16vh, 11rem);
  }

  /* ---------- Pain points: centrados, grandes, una a la vez ---------- */
  .problem__pains {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Mucho aire entre frases → cada una tiene su momento de scroll. */
    gap: clamp(5rem, 14vh, 9rem);
  }

  .problem__pain {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 6.5vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 22ch;
    color: var(--color-text-on-dark);
  }

  /* ---------- Frase puente (el giro) ---------- */
  /* Highlight tipográfico puro en naranja: SIN padding/borde/fondo para que
     nunca se lea como botón (naranja es el color de CTA de la marca). */
  .problem__bridge {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.5rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 22ch;
    color: var(--color-accent);
  }

  /* ---------- Pie de sección ---------- */
  .problem__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-white);
  }

  .problem__footer-text {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.875rem, 2vw, 1rem);
    letter-spacing: 0.06em;
    text-wrap: balance;
    color: var(--color-white);
  }

  .problem__footer-arrow {
    display: block;
    width: clamp(1.1rem, 2vw, 1.4rem);
    height: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--color-white);
    animation: problem-arrow-bounce 2s ease-in-out infinite;
  }

  .problem__footer-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes problem-arrow-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.85; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .problem__footer-arrow {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .problem__pain {
      font-size: clamp(1.75rem, 8vw, 2.75rem);
      max-width: 18ch;
    }
    .problem__pains {
      gap: clamp(4rem, 12vh, 6rem);
    }
  }
</style>

<script>
  import { initProblem } from "../../scripts/animations/problem.js";
  initProblem();
</script>
