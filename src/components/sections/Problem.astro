---
/**
 * Sección 3 — El problema que ayudamos a resolver.
 * Título + bajada introductoria + 3 párrafos (resumidos) + 3 cards
 * con mensajes destacados.
 *
 * Animaciones (problem.js):
 *  - Párrafos: reveal por LÍNEAS con giro 3D (clonado de FinalCTA).
 *  - Cards: sin entrada con scroll; solo hover verde (clonado de Method:
 *    spotlight radial, borde highlight, lift).
 */

const PARAGRAPHS = [
  "Tu esfuerzo necesita dirección. Entrenar con frecuencia no siempre significa avanzar: has probado rutinas, comenzado varias veces o entrenado sin saber si los ejercicios, las cargas y la progresión son las adecuadas. Te cuesta mantener la constancia, sientes inseguridad al moverte o no sabes cómo acercarte a tu objetivo.",
  "No siempre es falta de esfuerzo. Hace falta un proceso que considere tu punto de partida, tu contexto y cómo responde tu cuerpo. Convertimos tus objetivos en una ruta clara, medible y adaptable.",
];

const HIGHLIGHTS = [
  "No necesitas otra rutina genérica.",
  "Necesitas saber qué hacer, por qué hacerlo y cómo avanzar.",
  "Tu entrenamiento debe adaptarse a ti, no al contrario.",
];
---

<section class="problem" id="problema">
  <div class="problem__inner">
    <h2 class="problem__title">El problema que ayudamos a resolver</h2>

    <div class="problem__paragraphs">
      {PARAGRAPHS.map((text) => (
        <p class="problem__paragraph">{text}</p>
      ))}
    </div>

    <p class="problem__highlights-label">Ten en cuenta esto:</p>
    <ul class="problem__highlights" role="list">
      {HIGHLIGHTS.map((text) => (
        <li class="problem__highlight">{text}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problem {
    position: relative;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding-top: clamp(7rem, 22vh, 14rem);
    padding-bottom: clamp(6rem, 18vh, 11rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .problem__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  /* ---------- Título (mismo tamaño que About) ---------- */
  .problem__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 22ch;
    color: var(--color-text-on-dark);
  }

  /* ---------- Párrafos ---------- */
  .problem__paragraphs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: clamp(2rem, 6vh, 3rem);
    width: 100%;
    max-width: 58rem;
  }

  .problem__paragraph {
    font-family: var(--font-body);
    font-weight: var(--fw-light);
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.5;
    text-wrap: balance;
    color: var(--color-text-on-dark);
    opacity: 0.88;
  }

  /* ---------- Mensajes destacados (lista simple) ---------- */
  .problem__highlights-label {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(1.70rem, 2vw, 2.2rem);
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-white) 65%, transparent);
    margin: clamp(2rem, 5vh, 3rem) 0 0;
  }

  .problem__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.85rem, 2vh, 1.25rem);
    width: 100%;
    max-width: 44rem;
  }

  .problem__highlight {
    font-family: var(--font-body);
    font-weight: var(--fw-bold);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    text-align: left;
    text-wrap: balance;
    color: var(--color-text-on-dark);
    position: relative;
    padding-left: 1.5rem;
  }

  .problem__highlight::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-cta-hover);
    font-size: 1.1em;
    line-height: inherit;
  }
</style>

<script>
  import { initProblem } from "../../scripts/animations/problem.js";
  initProblem();
</script>
