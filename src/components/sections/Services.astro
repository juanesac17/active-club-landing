---
/**
 * Sección 6 — Servicios.
 * Infinite card slider con GSAP: card activa grande al centro y solo
 * la anterior y la siguiente visibles al fondo, más pequeñas y tenues.
 * Cards con el mismo lenguaje visual que Method.astro (borde blanco
 * translúcido, fondo sutil, radio 1.25rem); el amarillo queda reservado
 * para el copy destacado.
 *
 * Controlado por botones anterior/siguiente y por drag (sin ScrollTrigger:
 * el scroll de la página no se secuestra).
 *
 * Capa 2 (services.js): seamlessLoop + scrub.invalidate().restart()
 * sobre el playhead. Cards animan xPercent, scale y opacity según
 * avanzan por el centro del stage.
 *
 * LOOP = 3 copias de SERVICES (como en el HTML de referencia) para que
 * haya cards suficientes a izquierda y derecha del centro cuando se
 * entra por primera vez o al hacer wrap.
 */
import servicesLogoUrl from "../../assets/images/logotipo-blanco.svg?url";

const SERVICES = [
  {
    title: "Entrenamiento personal",
    benefit: "Sesiones diseñadas alrededor de tu condición actual y tus objetivos.",
  },
  {
    title: "Valoración, planificación y seguimiento",
    benefit: "Conocemos tu punto de partida y ajustamos el plan según tu evolución.",
  },
  {
    title: "Preparación para running y otros deportes",
    benefit: "Desarrollamos las capacidades físicas que exige tu disciplina.",
  },
  {
    title: "Fuerza, movilidad y acondicionamiento",
    benefit: "Mejora cómo te mueves y responde tu cuerpo dentro y fuera del entrenamiento.",
  },
];

// 3 copias para que el seamlessLoop tenga cards a los lados y el wrap
// del final al principio sea invisible.
const LOOP = [...SERVICES, ...SERVICES, ...SERVICES];
---

<section class="services" id="servicios" aria-labelledby="services-title" data-theme="dark">
  <img
    class="services__logo"
    src={servicesLogoUrl}
    alt=""
    width="2914"
    height="2528"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />

  <header class="services__header">
    <h2 class="services__title" id="services-title">El acompañamiento que necesitas</h2>
    <p class="services__subtitle">Elegimos las herramientas según tu objetivo, no al revés.</p>
  </header>

  <div
    class="services__stage"
    data-services-stage
    role="region"
    aria-label="Carrusel de servicios"
  >
    <ul class="services__track" role="list">
      {
        LOOP.map((service, i) => {
          return (
            <li
              class="services__card"
              aria-hidden={i >= SERVICES.length ? "true" : undefined}
            >
              <h3 class="services__card-title">{service.title}</h3>
              <p class="services__card-benefit">{service.benefit}</p>
            </li>
          );
        })
      }
    </ul>
    <div class="services__drag-proxy" data-services-drag-proxy></div>

    <button
      type="button"
      class="services__nav-btn services__nav-btn--prev"
      data-services-prev
      aria-label="Servicio anterior"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      class="services__nav-btn services__nav-btn--next"
      data-services-next
      aria-label="Siguiente servicio"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<style>
  .services {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
    border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-block: clamp(3.5rem, 9vh, 5.5rem) clamp(2.5rem, 6vh, 4rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
    /* Stage alto para dar protagonismo al coverflow (estilo galería). */
  }

  /* ---------- Header ---------- */
  .services__header {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 1.5vh, 1rem);
    margin-bottom: clamp(2rem, 4vh, 3rem);
  }

  .services__logo {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: clamp(24rem, 48vw, 44rem);
    height: auto;
    opacity: 0.08;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .services__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--on-surface);
  }

  .services__subtitle {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: var(--on-surface-muted);
  }

  /* ---------- Stage: viewport del coverflow ---------- */
  .services__stage {
    /* Ancho de la card activa: el track y las cards heredan de aquí. */
    --card-w: clamp(16rem, 30vw, 26rem);
    position: relative;
    z-index: 1;
    width: 100%;
    height: clamp(28rem, 70vh, 48rem);
    overflow: hidden;
    cursor: grab;
  }

  .services__stage:active {
    cursor: grabbing;
  }

  /* Proxy invisible que recibe el drag de Draggable. */
  .services__drag-proxy {
    visibility: hidden;
    position: absolute;
  }

  /* ---------- Track: contenedor de las cards ----------
     Ancho fijo (= card) centrado en el stage, como en el patrón del
     CodePen. IMPORTANTE: las cards NO llevan translate(-50%,-50%)
     propio — GSAP parsea ese translate porcentual como xPercent/yPercent
     y el tween de xPercent lo sobrescribe, descentrando todo. */
  .services__track {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: var(--card-w);
    aspect-ratio: 4 / 5; /* más ancha: el contenido respira mejor */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Card (mismo lenguaje visual que .method__step) ---------- */
  .services__card {
    /* Llena el track; GSAP controla xPercent, scale y opacity. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center; /* bloque de contenido centrado verticalmente */
    gap: clamp(0.65rem, 1.5vh, 1rem);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    text-align: center;
    border-radius: 1.25rem;
    border: 2px solid var(--border-default);
    background: var(--surface-raised);
    color: var(--on-surface);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .services__card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .services__card-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.7rem, 2.5vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--on-surface);
    margin: 0;
  }

  .services__card-benefit {
    font-family: var(--font-body);
    font-weight: var(--fw-light);
    font-size: clamp(1.1rem, 1.55vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-surface-muted);
    margin: 0;
  }

  /* ---------- Botones de navegación: a los costados del stage ----------
     Dentro del stage para quedar centrados respecto a las cards sin
     depender de la altura del header. Draggable ignora el press sobre
     clickables (button), así que no compiten con el drag. */
  .services__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 110; /* por encima de la card activa (zIndex 100 del tween) */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.75rem, 4.5vw, 3.5rem);
    height: clamp(2.75rem, 4.5vw, 3.5rem);
    border: 1.5px solid var(--border-default);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    color: var(--on-surface);
    cursor: pointer;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  .services__nav-btn--prev {
    left: clamp(0.5rem, 3vw, 2.5rem);
  }

  .services__nav-btn--next {
    right: clamp(0.5rem, 3vw, 2.5rem);
  }

  .services__nav-btn:hover {
    background: var(--on-surface);
    color: var(--surface);
    border-color: var(--on-surface);
    transform: translateY(-50%) scale(1.05);
  }

  .services__nav-btn:active {
    transform: translateY(-50%) scale(0.97);
  }

  .services__nav-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .services__nav-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (max-width: 768px) {
    .services__logo {
      width: 88%;
      opacity: 0.06;
    }
  }

  /* ---------- Reduced motion: scroll horizontal nativo ---------- */
  @media (prefers-reduced-motion: reduce) {
    .services__stage {
      overflow-x: auto;
      height: auto;
    }
    .services__track {
      position: static;
      transform: none;
      display: flex;
      gap: clamp(1rem, 2vw, 1.5rem);
      width: max-content;
      aspect-ratio: auto;
      padding: 1rem;
    }
    .services__card {
      position: static;
      width: clamp(15rem, 70vw, 20rem);
      height: auto;
      aspect-ratio: 4 / 5;
    }
    .services__card[aria-hidden="true"] {
      display: none;
    }
    .services__nav-btn {
      display: none;
    }
  }
</style>

<script>
  import { initServices } from "../../scripts/animations/services.js";
  initServices();
</script>
