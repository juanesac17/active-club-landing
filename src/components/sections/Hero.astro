---
/**
 * Hero — intro invertida: ventana del logo que crece.
 * Capa 2 (hero.js): intro, rotator de la franja rápida, parallax.
 */
import Button from "../ui/Button.astro";
import heroBg from "../../assets/images/fotoBanner.png";
import introLogoSvg from "../../assets/images/logo-vertical.svg?raw";
import { BRAND_DATA } from "../../data/brand";

// Palabras de la franja rápida (rotator). Estáticamente se muestra la primera;
// GSAP rota cada 2.8s.
const QUICK_PITCH_WORDS = [
  "Evaluamos",
  "Planificamos",
  "Entrenamos",
  "Ajustamos",
];
---

<section class="hero" id="hero" data-theme="dark">
  <!-- Escena enmascarada (máscara pequeña → enorme) -->
  <div class="hero__logo-mask" id="hero-logo-mask" aria-hidden="true">
    <div class="hero__key" id="hero-key">
      <!-- 3) Fondo — capa inferior -->
      <img
        src={heroBg.src}
        alt=""
        width={heroBg.width}
        height={heroBg.height}
        fetchpriority="high"
        decoding="async"
        data-hero-bg
        class="hero__key-bg"
      />
      <!-- 2) Logo vertical — escala en sync con logo-vertical-mask.svg (GSAP) -->
      <div class="hero__intro-logos" id="hero-intro-logos">
        <div class="hero__key-logo" id="hero-key-logo" set:html={introLogoSvg} aria-hidden="true"></div>
      </div>
      <div class="hero__scene-overlay"></div>
    </div>
  </div>

  <!-- Gate de intro — al click reproduce la entrada al hero -->
  <button type="button" class="hero__enter" id="hero-scroll-cue">
    <span class="hero__enter-label">Comencemos</span>
    <span class="hero__enter-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M4 12h13M13 7l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>

  <!-- Contenido principal -->
  <div class="hero__content">
    <p class="hero__eyebrow" data-hero-reveal>
      ENTRENAMIENTO PERSONAL · BIENESTAR · RENDIMIENTO
    </p>

    <!-- Franja de propuesta rápida con rotator — elemento dominante -->
    <p class="hero__pitch" data-hero-pitch data-hero-reveal>
      <span
        class="hero__pitch-rotator"
        data-hero-pitch-rotator
        data-words={JSON.stringify(QUICK_PITCH_WORDS)}
      >
        <span class="hero__pitch-word">{QUICK_PITCH_WORDS[0]}</span>
      </span>
    </p>

    <h1 class="hero__headline" data-hero-reveal>
      Un entrenamiento que se adapta a ti.
    </h1>

    <div class="hero__subtitle" data-hero-reveal>
      <p>
        Tu contexto cambia. Tu plan también. Evaluamos, acompañamos y ajustamos
        cada entrenamiento para cuidar tu bienestar y ayudarte a avanzar.
      </p>
    </div>

    <div class="hero__actions" data-hero-reveal>
      <Button href={BRAND_DATA.links.contact.href} variant="outline">
        Agendar cita por WhatsApp
      </Button>
      <a href="#metodo" class="hero__secondary">
        <span>Conocer la metodología</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
    color: var(--on-surface);
    isolation: isolate;
    /* Ancho del logo vertical intro (mismo viewBox que logo-vertical-mask.svg) */
    --intro-logo-w: clamp(80px, 14vw, 160px);
    --intro-logo-h: calc(var(--intro-logo-w) * 2855 / 4498);
  }

  /* Anti-FOUC: ocultamos los elementos de entrada SOLO si hay JS y el
     usuario no pidió menos movimiento. GSAP los revela en la entrada.
     Sin JS o con reduced-motion → quedan visibles por defecto. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hero-reveal],
    :global(html.js) [data-hero-intro-ui],
    :global(html.js) .hero__pitch-word {
      opacity: 0;
    }
  }

  /* 1) Máscara logo-vertical-mask.svg en .hero__logo-mask (arriba) */
  .hero__logo-mask {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-black);
    -webkit-mask-image: url("/logo-vertical-mask.svg");
    mask-image: url("/logo-vertical-mask.svg");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center center;
    mask-position: center center;
    -webkit-mask-size: var(--intro-logo-w) auto;
    mask-size: var(--intro-logo-w) auto;
    -webkit-mask-mode: alpha;
    mask-mode: alpha;
  }

  .hero.is-intro-unmasked .hero__logo-mask {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .hero__key {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(1.25);
    transform-origin: center center;
    will-change: transform;
  }

  .hero__key-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    will-change: transform;
  }

  /* 2) Logo vertical — comparte ancho y escala con la máscara (GSAP) */
  .hero__intro-logos {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }

  .hero__key-logo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5))
      drop-shadow(0 0 8px rgba(0, 0, 0, 0.6));
  }
  .hero__key-logo :global(svg) {
    width: var(--intro-logo-w);
    height: auto;
    display: block;
  }

  .hero__scene-overlay {
    z-index: 2;
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        var(--color-black) 0%,
        color-mix(in srgb, var(--color-black) 80%, transparent) 38%,
        color-mix(in srgb, var(--color-black) 30%, transparent) 70%,
        transparent 100%
      ),
      linear-gradient(
        0deg,
        var(--color-black) 2%,
        transparent 45%
      );
  }

  .hero.is-intro-complete .hero__scene-overlay {
    opacity: 1;
  }

  /* ---------- Nav interno eliminado: la navegación vive en layout/Header.astro ---------- */

  /* ---------- Contenido ---------- */
  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 60rem;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .hero__eyebrow {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: var(--fw-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: none;
    color: var(--on-surface);
    opacity: 1;
    text-wrap: balance;
  }

  /* Franja de propuesta rápida — rotator de palabras, elemento dominante */
  .hero__pitch {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.25rem, 3.5vw, 2.5rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-top: 0.25rem;
  }
  .hero__pitch-rotator {
    display: inline-block;
    position: relative;
    overflow: hidden;
  }
  .hero__pitch-word {
    display: inline-block;
    will-change: transform;
  }
  /* Clon de la palabra saliente: superpuesto para animar salida y entrada a la vez */
  .hero__pitch-word.is-leaving {
    position: absolute;
    top: 0;
    left: 0;
  }

  .hero__subtitle {
    font-weight: var(--fw-light);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    max-width: 42ch;
    opacity: 0.78;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hero__subtitle p {
    margin: 0;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .hero__secondary {
    position: relative;
    font-size: 0.95rem;
    font-weight: var(--fw-regular);
    color: var(--on-surface);
    opacity: 0.85;
    padding-bottom: 4px;
  }
  .hero__secondary span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0.4);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .hero__secondary:hover span::after {
    transform: scaleX(1);
  }

  /* ---------- Gate de intro — botón anclado al viewport, no al hero ----------
     Importante: el hero puede crecer más allá de 100dvh por el contenido,
     así que el gate debe estar fijo al viewport para no quedar fuera. */
  .hero__enter {
    position: fixed;
    z-index: 2;
    left: 50%;
    bottom: clamp(1.5rem, 4vw, 3rem);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--color-white);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    font-weight: var(--fw-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--color-black) 35%, transparent);
    backdrop-filter: blur(6px);
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.8);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }
  .hero__enter:hover {
    color: var(--color-black);
    background: var(--color-white);
    border-color: var(--color-white);
    text-shadow: none;
    transform: translateX(-50%) translateY(-2px);
  }

  .hero__enter-arrow {
    display: block;
    width: clamp(1.1rem, 2vw, 1.4rem);
    height: clamp(1.1rem, 2vw, 1.4rem);
    color: currentColor;
    animation: scroll-arrow-bounce 2s ease-in-out infinite;
  }
  .hero__enter-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.65));
  }
  @keyframes scroll-arrow-bounce {
    0%, 100% { transform: translateX(0); opacity: 0.85; }
    50% { transform: translateX(4px); opacity: 1; }
  }

  /* ---------- Foco visible (teclado) ---------- */
  .hero__secondary:focus-visible,
  .hero__enter:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 999px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .hero {
      --intro-logo-w: clamp(150px, 46vw, 210px);
    }
  }

  @media (max-width: 560px) {
    .hero {
      --intro-logo-w: clamp(172px, 58vw, 240px);
      padding-inline: clamp(1rem, 4vw, 1.25rem);
    }

    .hero__content {
      align-items: flex-start;
    }

    .hero__enter {
      gap: 0.55rem;
      padding: 0.75rem 1.5rem;
      font-size: clamp(0.72rem, 3.1vw, 0.85rem);
      letter-spacing: 0.14em;
      bottom: clamp(1.25rem, 5vw, 2rem);
    }
  }

  @media (max-width: 380px) {
    .hero {
      --intro-logo-w: clamp(160px, 62vw, 220px);
    }

    .hero__enter {
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logo-mask {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__key {
      transform: none;
    }
    .hero__scene-overlay {
      opacity: 1;
    }
    .hero__enter-arrow {
      animation: none;
    }
  }
</style>

<script>
  import { initHero } from "../../scripts/animations/hero.js";
  initHero();
</script>
