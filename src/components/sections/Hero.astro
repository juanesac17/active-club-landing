---
/**
 * Hero — intro invertida: ventana del logo que crece.
 * Capa 2 (hero.js): intro, palabra rotatoria, parallax.
 */
import Button from "../ui/Button.astro";
import heroBg from "../../assets/images/hero-bg.webp";
import navLogoSvg from "../../assets/images/logo-horizontal.svg?raw";
import introLogoSvg from "../../assets/images/logo-vertical.svg?raw";

// TODO: reemplazar por el link wa.me real cuando esté el número (whatsapp.js).
const WHATSAPP_URL = "#contacto";

// Palabras de la rotación. Estáticamente se muestra la primera; GSAP usará todas.
const ROTATING_WORDS = ["propósito", "ciencia", "dirección", "resultados"];
---

<section class="hero" id="hero">
  <!-- Escena enmascarada (máscara pequeña → enorme) -->
  <div class="hero__logo-mask" id="hero-logo-mask" aria-hidden="true">
    <div class="hero__key" id="hero-key">
      <!-- 3) Fondo — capa inferior -->
      <img
        src={heroBg.src}
        alt=""
        width={heroBg.width}
        height={heroBg.height}
        fetchpriority="high"
        decoding="async"
        data-hero-bg
        class="hero__key-bg"
      />
      <!-- 2) Logo vertical — escala en sync con logo-vertical-mask.svg (GSAP) -->
      <div class="hero__intro-logos" id="hero-intro-logos">
        <div class="hero__key-logo" id="hero-key-logo" set:html={introLogoSvg} aria-hidden="true"></div>
      </div>
      <div class="hero__scene-overlay"></div>
    </div>
  </div>

  <!-- Gate de intro — al click reproduce la entrada al hero -->
  <button type="button" class="hero__enter" id="hero-scroll-cue">
    <span class="hero__enter-label">Comencemos</span>
    <span class="hero__enter-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M4 12h13M13 7l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>

  <!-- Nav -->
  <header class="hero__nav" data-hero-nav>
    <a href="/" class="hero__logo" aria-label="Active Club — inicio" set:html={navLogoSvg}></a>
    <Button href={WHATSAPP_URL} variant="outline" external>Contactar</Button>
  </header>

  <!-- Contenido principal -->
  <div class="hero__content">
    <p class="hero__eyebrow" data-hero-reveal>
      Entrenamiento personalizado · Basado en ciencia
    </p>

    <h1 class="hero__headline">
      <span class="hero__headline-line" data-hero-reveal>Entrena con</span>
      <span
        class="hero__rotator"
        data-hero-rotator
        data-words={JSON.stringify(ROTATING_WORDS)}
      >
        <span class="hero__word">{ROTATING_WORDS[0]}</span>
      </span>
    </h1>

    <p class="hero__subtitle" data-hero-reveal>
      Asesoría personalizada para mejorar tu rendimiento físico, con un método
      respaldado por evidencia.
    </p>

    <div class="hero__actions" data-hero-reveal>
      <Button href={WHATSAPP_URL} variant="outline" external>Quiero empezar</Button>
      <a href="#metodo" class="hero__secondary">
        <span>Conocé el método</span>
      </a>
    </div>
  </div>

  <!-- Stats (borde derecho) -->
  <ul class="hero__stats" data-hero-intro-ui>
    <li><span class="hero__stat-num">100%</span><span class="hero__stat-label">Personalizado</span></li>
    <li><span class="hero__stat-num">2x</span><span class="hero__stat-label">Tu rendimiento</span></li>
    <li><span class="hero__stat-num">∞</span><span class="hero__stat-label">Ajuste continuo</span></li>
  </ul>

  <!-- Barra inferior: dots -->
  <div class="hero__footer">
    <ul class="hero__dots" data-hero-dots data-hero-intro-ui aria-hidden="true">
      <li class="is-active"></li>
      <li></li>
      <li></li>
      <li></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
    color: var(--color-text-on-dark);
    isolation: isolate;
    /* Ancho del logo vertical intro (mismo viewBox que logo-vertical-mask.svg) */
    --intro-logo-w: clamp(80px, 14vw, 160px);
    --intro-logo-h: calc(var(--intro-logo-w) * 2855 / 4498);
  }

  /* Anti-FOUC: ocultamos los elementos de entrada SOLO si hay JS y el
     usuario no pidió menos movimiento. GSAP los revela en la entrada.
     Sin JS o con reduced-motion → quedan visibles por defecto. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hero-nav],
    :global(html.js) [data-hero-reveal],
    :global(html.js) [data-hero-intro-ui],
    :global(html.js) .hero__rotator {
      opacity: 0;
    }
  }

  /* 1) Máscara logo-vertical-mask.svg en .hero__logo-mask (arriba) */
  .hero__logo-mask {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-bg-dark);
    -webkit-mask-image: url("/logo-vertical-mask.svg");
    mask-image: url("/logo-vertical-mask.svg");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center center;
    mask-position: center center;
    -webkit-mask-size: var(--intro-logo-w) auto;
    mask-size: var(--intro-logo-w) auto;
    -webkit-mask-mode: alpha;
    mask-mode: alpha;
  }

  .hero.is-intro-unmasked .hero__logo-mask {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .hero__key {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(1.25);
    transform-origin: center center;
    will-change: transform;
  }

  .hero__key-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    will-change: transform;
  }

  /* 2) Logo vertical — comparte ancho y escala con la máscara (GSAP) */
  .hero__intro-logos {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }

  .hero__key-logo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5))
      drop-shadow(0 0 8px rgba(0, 0, 0, 0.6));
  }
  .hero__key-logo :global(svg) {
    width: var(--intro-logo-w);
    height: auto;
    display: block;
  }

  .hero__scene-overlay {
    z-index: 2;
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        var(--color-bg-dark) 0%,
        color-mix(in srgb, var(--color-bg-dark) 80%, transparent) 38%,
        color-mix(in srgb, var(--color-bg-dark) 30%, transparent) 70%,
        transparent 100%
      ),
      linear-gradient(
        0deg,
        var(--color-bg-dark) 2%,
        transparent 45%
      );
  }

  .hero.is-intro-complete .hero__scene-overlay {
    opacity: 1;
  }

  /* ---------- Nav ---------- */
  .hero__nav {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero__logo {
    display: block;
    width: clamp(120px, 14vw, 168px);
    color: var(--color-white);
  }
  .hero__logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---------- Contenido ---------- */
  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 60rem;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .hero__eyebrow {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: var(--fw-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cta-hover);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(3rem, 11vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero__headline-line {
    display: block;
  }

  /* Palabra rotatoria — highlight tipográfico en amarillo (token de marca) */
  .hero__rotator {
    display: block;
    position: relative;
    overflow: hidden;
    color: var(--color-cta-hover);
  }
  .hero__word {
    display: inline-block;
    will-change: transform;
  }
  /* Clon de la palabra saliente: superpuesto para animar salida y entrada a la vez */
  .hero__word.is-leaving {
    position: absolute;
    top: 0;
    left: 0;
  }

  .hero__subtitle {
    font-weight: var(--fw-light);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    max-width: 38ch;
    opacity: 0.72;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .hero__secondary {
    position: relative;
    font-size: 0.95rem;
    font-weight: var(--fw-regular);
    color: var(--color-text-on-dark);
    opacity: 0.85;
    padding-bottom: 4px;
  }
  .hero__secondary span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0.4);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .hero__secondary:hover span::after {
    transform: scaleX(1);
  }

  /* ---------- Stats (borde derecho) ---------- */
  .hero__stats {
    position: absolute;
    z-index: 1;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(7rem, 16vh, 9rem);
    list-style: none;
    display: grid;
    gap: 1rem;
    padding-right: 1rem;
    border-right: 2px solid var(--color-cta-hover);
    text-align: right;
    /* El borde derecho cae sobre la zona clara de la foto → sombra para contraste */
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }
  .hero__stats li {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
  }
  .hero__stat-num {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
  }
  .hero__stat-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-top: 0.25rem;
  }

  /* ---------- Tags (derecha) ---------- */
  .hero__tags {
    position: absolute;
    z-index: 1;
    right: clamp(1.25rem, 3vw, 2.5rem);
    top: clamp(5.5rem, 16vh, 9rem);
    list-style: none;
    display: grid;
    gap: 0.6rem;
    justify-items: end;
  }
  .hero__tags li {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 22%, transparent);
    border-radius: 999px;
    /* Scrim: garantiza contraste del texto sobre zonas claras de la foto */
    background: color-mix(in srgb, var(--color-bg-dark) 55%, transparent);
    backdrop-filter: blur(4px);
  }

  /* ---------- Footer: dots ---------- */
  .hero__footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 1rem;
  }

  /* Gate de intro — botón centrado bajo el logo, visible con la máscara */
  .hero__enter {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(1.5rem, 4vw, 3rem);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.85rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 55%, transparent);
    border-radius: 999px;
    color: var(--color-white);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    font-weight: var(--fw-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--color-bg-dark) 35%, transparent);
    backdrop-filter: blur(6px);
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.8);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }
  .hero__enter:hover {
    color: var(--color-black);
    background: var(--color-white);
    border-color: var(--color-white);
    text-shadow: none;
    transform: translateX(-50%) translateY(-2px);
  }

  .hero__enter-arrow {
    display: block;
    width: clamp(1.1rem, 2vw, 1.4rem);
    height: clamp(1.1rem, 2vw, 1.4rem);
    color: currentColor;
    animation: scroll-arrow-bounce 2s ease-in-out infinite;
  }
  .hero__enter-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.65));
  }
  @keyframes scroll-arrow-bounce {
    0%, 100% { transform: translateX(0); opacity: 0.85; }
    50% { transform: translateX(4px); opacity: 1; }
  }

  .hero__dots {
    list-style: none;
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }
  .hero__dots li {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-white) 25%, transparent);
    transition: background 0.3s ease, width 0.3s ease;
  }
  .hero__dots li.is-active {
    width: 22px;
    border-radius: 999px;
    background: var(--color-cta-hover);
  }

  /* ---------- Foco visible (teclado) ---------- */
  .hero__logo:focus-visible,
  .hero__secondary:focus-visible,
  .hero__enter:focus-visible {
    outline: 2px solid var(--color-cta-hover);
    outline-offset: 4px;
    border-radius: 999px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .hero {
      --intro-logo-w: clamp(150px, 46vw, 210px);
    }
  }

  @media (max-width: 1024px) {
    .hero__stats,
    .hero__tags {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      --intro-logo-w: clamp(172px, 58vw, 240px);
      padding-inline: clamp(1rem, 4vw, 1.25rem);
    }

    .hero__content {
      align-items: flex-start;
    }
    .hero__dots {
      display: none;
    }

    .hero__enter {
      gap: 0.55rem;
      padding: 0.75rem 1.5rem;
      font-size: clamp(0.72rem, 3.1vw, 0.85rem);
      letter-spacing: 0.14em;
      bottom: clamp(1.25rem, 5vw, 2rem);
    }
  }

  @media (max-width: 380px) {
    .hero {
      --intro-logo-w: clamp(160px, 62vw, 220px);
    }

    .hero__enter {
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logo-mask {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__key {
      transform: none;
    }
    .hero__scene-overlay {
      opacity: 1;
    }
    .hero__enter-arrow {
      animation: none;
    }
  }
</style>

<script>
  import { initHero } from "../../scripts/animations/hero.js";
  initHero();
</script>
