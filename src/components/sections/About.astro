---
/**
 * Sección 2 — Quiénes somos.
 * Título grande, 3 párrafos con reveal por caracteres (SplitText)
 * y CTA al final. Animación clonada de Problem, con tamaño de
 * letra más pequeño en los párrafos.
 * Capa 2 (about.js): reveal por chars + ScrollTrigger (one-time).
 */

const PARAGRAPHS = [
  "Active Club es una marca de entrenamiento personal, preparación física y bienestar que acompaña a personas y deportistas en la construcción de una mejor condición física y una relación más consciente con su cuerpo.",
  "Cada proceso parte de conocer tu historia, necesidades, capacidades y objetivos. A partir de esta información, diseñamos una planificación que integra fuerza, movilidad, acondicionamiento físico, seguimiento y educación.",
  "No trabajamos con rutinas genéricas ni medimos el servicio únicamente por el tiempo de una sesión. Evaluamos tu progreso, ajustamos el plan y te acompañamos para que puedas moverte mejor, sentirte más seguro y avanzar hacia resultados sostenibles.",
];
---

<section class="about" id="quienes-somos">
  <div class="about__inner">
    <h2 class="about__title">Mucho más que una sesión de entrenamiento</h2>

    <div class="about__paragraphs">
      {PARAGRAPHS.map((text) => (
        <p class="about__paragraph">{text}</p>
      ))}
    </div>

    <a href="#contacto" class="about__cta">
      Quiero conocer mi punto de partida
    </a>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding-top: clamp(7rem, 22vh, 14rem);
    padding-bottom: clamp(5rem, 12vh, 8rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
  }

  .about__inner {
    max-width: 64rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  .about__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 22ch;
    color: var(--color-text-on-dark);
  }

  .about__paragraphs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    /* Aire entre párrafos → cada uno tiene su momento de scroll */
    gap: clamp(2.5rem, 7vh, 4.5rem);
    width: 100%;
    max-width: 58rem;
  }

  .about__paragraph {
    font-family: var(--font-body);
    font-weight: var(--fw-light);
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.5;
    text-wrap: balance;
    color: var(--color-text-on-dark);
    opacity: 0.88;
  }

  .about__cta {
    display: inline-block;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    padding: 0.95rem 1.95rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 55%, transparent);
    border-radius: 999px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-bg-dark) 35%, transparent);
    backdrop-filter: blur(6px);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  .about__cta:hover {
    color: var(--color-black);
    background: var(--color-white);
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .about__cta:focus-visible {
    outline: 2px solid var(--color-cta-hover);
    outline-offset: 4px;
    border-radius: 999px;
  }

  @media (max-width: 768px) {
    .about__title {
      font-size: clamp(2rem, 8vw, 3rem);
      max-width: 18ch;
    }
    .about__paragraphs {
      gap: clamp(2rem, 6vh, 3rem);
    }
  }
</style>

<script>
  import { initAbout } from "../../scripts/animations/about.js";
  initAbout();
</script>
