---
/**
 * BaseLayout — esqueleto HTML de la landing.
 * Responsabilidad única: <head> (meta tags, SEO, fuentes), <body> con slots
 * y decoraciones globales del viewport. Header / Footer se ensamblan en la página.
 */
import "../styles/global.css";
import ScrollFade from "../components/layout/ScrollFade.astro";
import { BRAND_DATA } from "../data/brand";

interface Props {
  /** Título de la pestaña y og:title. */
  title?: string;
  /** Meta description + og:description. */
  description?: string;
  /** Imagen para compartir en redes (ruta relativa a la raíz pública). */
  image?: string;
}

const {
  title = BRAND_DATA.site.defaultTitle,
  description = BRAND_DATA.site.defaultDescription,
  image = BRAND_DATA.assets.socialImage,
} = Astro.props;

// Astro.site se define en astro.config cuando haya dominio. Hasta entonces,
// cae a Astro.url para que el build no rompa.
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base);
const socialImage = new URL(image, base);
---

<!doctype html>
<html lang={BRAND_DATA.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca que hay JS antes del primer paint (anti-FOUC para las
         animaciones de entrada). Inline para que corra de inmediato. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/svg+xml" href={BRAND_DATA.assets.favicon} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primarios -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content={BRAND_DATA.site.themeColor} />

    <!-- Preload de fuentes críticas above-the-fold (evita FOUT en el Hero).
         crossorigin es obligatorio: las fuentes se piden en modo CORS. -->
    <link
      rel="preload"
      href="/fonts/made-outer-sans-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/tt-firs-neue-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={BRAND_DATA.site.ogLocale} />
    <meta property="og:site_name" content={BRAND_DATA.site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <main id="main-content">
      <slot />
    </main>
    <!-- Footer fuera de <main>: semántica correcta para el cierre del sitio. -->
    <slot name="footer" />
    <ScrollFade />
  </body>
</html>
